#cloud-config
# GNOME desktop VM for Myna Settings end-to-end tests. Rendered by
# provision.sh: ${SSH_PUBLIC_KEY}, ${RELEASE} and ${HOSTNAME} are substituted.
#
# The package set follows authd's e2e template (gdm3 + gnome-shell on a server
# cloud image, no ubuntu-desktop metapackage) plus the AT-SPI driver's tools.
password: ubuntu
ssh_pwauth: true
users:
  - name: ubuntu
    sudo: [ 'ALL=(ALL) NOPASSWD:ALL' ]
    lock_passwd: false
    gecos: Ubuntu
    groups: sudo
    homedir: /home/ubuntu
    shell: /bin/bash
    ssh_authorized_keys:
      - ${SSH_PUBLIC_KEY}
chpasswd:
  expire: false
  users:
    - { name: ubuntu, password: ubuntu, type: text }

package_update: true
package_upgrade: true
packages:
  # Desktop (authd's proven minimal set)
  - fonts-ubuntu
  - gdm3
  - gnome-shell
  - gnome-shell-extension-ubuntu-dock
  - gnome-terminal
  - gnome-text-editor
  - gsettings-ubuntu-schemas
  - policykit-desktop-privileges
  - spice-vdagent
  - ubuntu-settings
  - yaru-theme-gtk
  - yaru-theme-icon
  # Test driver dependencies (shot-driver.py and friends run inside the VM)
  - python3-gi
  - gir1.2-atspi-2.0
  - xvfb
  - xcompmgr
  - xdotool
  - imagemagick
  - x11-utils
  - dconf-cli
  - dbus-x11
  - psmisc
  - jq
  # Plumbing
  - openssh-server
  - qemu-guest-agent
  - socat
  - software-properties-common
  - systemd-timesyncd

write_files:
  # GDM autologin: every boot lands on ubuntu's GNOME session without
  # interaction. Myna tests nothing at the greeter.
  - path: /etc/gdm3/custom.conf
    content: |
      [daemon]
      AutomaticLoginEnable=true
      AutomaticLogin=ubuntu

  - path: /etc/dconf/profile/user
    content: |
      user-db:user
      system-db:local

  - path: /etc/dconf/db/local.d/00-e2e-tests-requirements
    content: |
      # No suspend, no screen blanking, no lock: a test must never find
      # the session asleep.
      [org/gnome/settings-daemon/plugins/power]
      sleep-inactive-ac-type='nothing'
      sleep-inactive-ac-timeout=0

      [org/gnome/desktop/session]
      idle-delay=uint32 0

      [org/gnome/desktop/screensaver]
      lock-enabled=false

runcmd:
  # The user manager must run without a login too, so systemctl --user works
  # over SSH and the dictation user daemon survives between suites.
  - loginctl enable-linger ubuntu
  # Disable apport
  - sed -i 's/enabled=1/enabled=0/' /etc/default/apport
  - systemctl mask --now apport.service
  # Update dconf database
  - dconf update
  # Speed up boot
  - systemctl mask systemd-networkd-wait-online.service
  # No APT activity during tests
  - systemctl mask apt-daily.service apt-daily.timer apt-daily-upgrade.service apt-daily-upgrade.timer unattended-upgrades.service
  - rm -f /etc/apt/apt.conf.d/20auto-upgrades /etc/apt/apt.conf.d/50unattended-upgrades

final_message: "Provisioning finished after $UPTIME seconds"

power_state:
  mode: poweroff
  message: Shutting down instance after initial setup
  condition: True
  timeout: 30
