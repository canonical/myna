#cloud-config
# GNOME-specific part of the e2e VM's cloud-init user-data, merged after
# user-data.common by lib.sh.
#
# The package set follows authd's e2e template (gdm3 + gnome-shell on a server
# cloud image, no ubuntu-desktop metapackage).
packages:
  - fonts-ubuntu
  - gdm3
  - gnome-shell
  - gsettings-ubuntu-schemas
  - policykit-desktop-privileges
  - ubuntu-settings
  - yaru-theme-gtk
  - yaru-theme-icon

write_files:
  # GDM autologin: every boot lands on ubuntu's GNOME session without
  # interaction. Myna tests nothing at the greeter.
  - path: /etc/gdm3/custom.conf
    content: |
      [daemon]
      AutomaticLoginEnable=true
      AutomaticLogin=ubuntu

  - path: /etc/dconf/profile/user
    content: |
      user-db:user
      system-db:local

  - path: /etc/dconf/db/local.d/00-e2e-tests-requirements
    content: |
      # No suspend, no screen blanking, no lock: a test must never find
      # the session asleep.
      [org/gnome/settings-daemon/plugins/power]
      sleep-inactive-ac-type='nothing'
      sleep-inactive-ac-timeout=0

      [org/gnome/desktop/session]
      idle-delay=uint32 0

      [org/gnome/desktop/screensaver]
      lock-enabled=false

runcmd:
  # Update dconf database
  - dconf update
