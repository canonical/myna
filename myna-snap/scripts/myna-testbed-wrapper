#!/bin/sh
# myna-testbed launcher: PipeWire compat symlinks, then exec against the
# backend shared over the `backend` content interface, found the way the
# daemon finds it (see myna-daemon).
set -eu
# shellcheck source=/dev/null  # generated inside the snap at runtime
. "$SNAP/bin/myna-runtime-links"
exec "$SNAP/bin/myna-testbed" --backend-dir "$SNAP_DATA/backend" "$@"
