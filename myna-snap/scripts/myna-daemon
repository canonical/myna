#!/bin/sh
# myna daemon launcher (snap): the ExecStart of the per-user systemd service
# (`daemon: simple` + `daemon-scope: user`), wiring myna-desktop up against the
# backend socket shared over the `backend` content interface.
#
# The unit starts at PAM login, which is before the compositor, PipeWire, IBus
# and the portal exist. Nothing here waits for them and nothing here checks for
# them: myna-desktop treats all four as things that come and go, so the only
# job left for this script is to say *where* things are.
#
# The launcher deliberately passes no activation, indicator or preedit flags:
# myna-desktop resolves all three itself (portal activation because $SNAP is
# set, com.canonical.Myna.Dictation always served with a notification fallback, preedit
# from the persisted streaming mode). Anything this script "helpfully" pinned
# here would be a default the user cannot see and cannot change.
#
# The backend is handed over as a *directory*, not a socket. snapd appends the
# slot's source basename to the content target, so the share lands at
# $SNAP_DATA/backend/run (and run-2, run-3, … for further connections), a
# `snap refresh` of the backend re-creates it, and before the first
# `snap connect` there is nothing there at all. myna-desktop re-resolves it at
# every press, so a backend installed, connected or refreshed *after* login
# needs no restart, and "no backend yet" shows on the indicator instead of
# taking the daemon down. Deciding it here, once, would have made the daemon's
# whole lifetime hostage to the state of the mount at login.
#
# Env knobs (all optional):
#   MYNA_BACKEND_SOCKET  exact backend socket path (bypasses the share)
#   MYNA_LANGUAGE        language hint for the session config
# Extra args go straight to myna-desktop. As a daemon app this has no
# /snap/bin entry (wrappers/binaries.go:218 skips services), so pass them with
# `snap stop myna && snap run myna --stdin`, or via the unit's environment.
set -eu

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    exec "$SNAP/bin/myna-desktop" --help
fi

# System-wide defaults from `snap set myna …`, written by the configure hook.
# Exported, not turned into flags: myna-desktop treats them as the *lowest*
# precedence (below the user's own GSettings values), and a flag here would
# outrank the user - see `Resolved` in myna-desktop.
#
# Parsed, never sourced. A hotkey is spelled `<Super>d`, which as shell input is
# a redirection: sourcing it took the daemon down with status 2 and straight
# into systemd's restart limit (found live, 2026-08-26). Parsing also means a
# root-written file is data to this user process, not code.
if [ -f "$SNAP_DATA/config.env" ]; then
    while IFS='=' read -r key value; do
        case "$key" in
            MYNA_CFG_ACTIVATION | MYNA_CFG_LANGUAGE | MYNA_CFG_HOTKEY)
                export "$key=$value"
                ;;
        esac
    done < "$SNAP_DATA/config.env"
fi

# PipeWire/Wayland compat symlinks (see bin/myna-runtime-links).
# shellcheck source=/dev/null  # generated inside the snap at runtime
. "$SNAP/bin/myna-runtime-links"

if [ -n "${MYNA_BACKEND_SOCKET:-}" ]; then
    set -- --socket "$MYNA_BACKEND_SOCKET" "$@"
else
    set -- --backend-dir "$SNAP_DATA/backend" "$@"
fi

if [ -n "${MYNA_LANGUAGE:-}" ]; then
    set -- --language "$MYNA_LANGUAGE" "$@"
fi

exec "$SNAP/bin/myna-desktop" "$@"
