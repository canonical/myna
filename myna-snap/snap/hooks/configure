#!/bin/sh
# `snap set myna …` — the system-wide half of the client's configuration.
#
# Two planes, deliberately:
#
#   gsettings set com.canonical.Myna.Dictation …   per user, unprivileged, what a
#                                        Settings page writes
#   snap set myna …                      per machine, root, what an image build
#                                        or an admin presets
#
# The user's value wins where both exist (myna-desktop's `Resolved`): snapd
# configuration is per *snap*, not per user, so it can only ever be a default.
#
# snapd runs this as root on install and on every `snap set`/`snap unset`. It
# cannot write the per-user store from here (dconf is per user, and at install
# there may be no user logged in at all), so it validates and hands the values
# to the launcher through $SNAP_DATA, which the user daemon can read.
set -eu

fail() {
    echo "$1" >&2
    exit 1
}

activation=$(snapctl get activation || true)
case "$activation" in
    "" | auto | portal | control) ;;
    *) fail "activation must be auto, portal or control (got '$activation')" ;;
esac
# `auto` is the absence of a choice; store nothing rather than a value the
# daemon would have to special-case.
if [ "$activation" = auto ]; then
    activation=""
fi

# Deliberately narrow: a language "hint" is a short code (en, fr, zh-CN), and
# anything longer is a mistake worth reporting at `snap set` time rather than
# passing to a backend that will ignore it.
language=$(snapctl get language || true)
case "$language" in
    "") ;;
    *[!A-Za-z0-9_-]* | ?????????*) fail "language must be a short code like en, fr, zh-CN (got '$language')" ;;
esac

hotkey=$(snapctl get hotkey || true)
case "$hotkey" in
    "") ;;
    *[[:space:]]*) fail "hotkey must be an accelerator like '<Super>d', with no spaces (got '$hotkey')" ;;
esac

# One file, rewritten whole: a key that was unset has to *disappear*, not
# linger from the last `snap set`.
config="$SNAP_DATA/config.env"
tmp="$config.new"
{
    echo "# Written by the configure hook. Change with: snap set myna key=value"
    if [ -n "$activation" ]; then echo "MYNA_CFG_ACTIVATION=$activation"; fi
    if [ -n "$language" ]; then echo "MYNA_CFG_LANGUAGE=$language"; fi
    if [ -n "$hotkey" ]; then echo "MYNA_CFG_HOTKEY=$hotkey"; fi
} > "$tmp"
mv "$tmp" "$config"

# The daemon reads its configuration once, at start. `snapctl restart` drives
# the *system* service manager, which is not where a user daemon lives, so this
# deliberately does not try: the values apply at the next start, and
# `snap restart myna` applies them now.
