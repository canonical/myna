msgstr "Nem érhető el gyorsbillentyű"

#: src/inject/mod.rs:51
msgid "Password field skipped"
msgstr "Jelszómező kihagyva"

#: src/inject/mod.rs:52
msgid "No text field focused"
msgstr "Nincs szövegmező fókuszálva"

#: src/inject/mod.rs:54
msgid "Typing unavailable"
msgstr "A gépelés nem érhető el"

#: src/inject/mod.rs:55
