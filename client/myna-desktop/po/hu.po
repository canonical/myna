#: src/indicator/mod.rs:79
msgid "Loading model…"
msgstr "Modell betöltése…"

#: src/indicator/mod.rs:80
msgid "Listening"
msgstr "Hallgatás"

#: src/indicator/mod.rs:81
msgid "Transcribing"
msgstr "Leírás"

#: src/indicator/mod.rs:82
msgid "Finishing"
msgstr "Befejezés"

#: src/indicator/mod.rs:86
#, c-format
msgid "Error: %s"
msgstr "Hiba: %s"

#: src/indicator/notify.rs:42
msgid "🎤 Dictation: listening"
msgstr "🎤 Diktálás: hallgatás"

#: src/indicator/notify.rs:43
msgid "Speak now. Press your shortcut again to stop."
msgstr "Most beszéljen. Nyomja meg újra a gyorsbillentyűt a leállításhoz."

#: src/indicator/notify.rs:46
msgid "💬 Dictation: transcribing"
msgstr "💬 Diktálás: leírás"

#: src/indicator/notify.rs:47
msgid "Converting speech to text…"
msgstr "Beszéd szöveggé alakítása…"

#: src/indicator/notify.rs:50
msgid "⏳ Dictation: finishing"
msgstr "⏳ Diktálás: befejezés"

#: src/indicator/notify.rs:51
msgid "Inserting the final text…"
msgstr "A végleges szöveg beszúrása…"

#: src/indicator/notify.rs:54
msgid "⚠️ Dictation error"
msgstr "⚠️ Diktálási hiba"

#: src/controller.rs:218 src/inject/mod.rs:53
msgid "Focus lost"
msgstr "A fókusz elveszett"

#: src/controller.rs:220
msgid "No speech detected"
msgstr "Nincs beszéd észlelve"

#: src/controller.rs:222
msgid "Background noise is high"
msgstr "A háttérzaj erős"

#: src/controller.rs:760
msgid "Text field closed"
msgstr "A szövegmező bezárva"

#. TRANSLATORS: the keyboard shortcut's name in the desktop's dialog and settings.
#: src/shortcut/portal.rs:99
msgid "Dictation (tap to start or stop)"
msgstr "Diktálás (koppintson az indításhoz vagy a leállításhoz)"

