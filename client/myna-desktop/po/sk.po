#: src/indicator/mod.rs:84
msgid "Loading model…"
msgstr "Načítava sa model…"

#: src/indicator/mod.rs:85
msgid "Listening"
msgstr "Počúva sa"

#: src/indicator/mod.rs:86
msgid "Transcribing"
msgstr "Prepisuje sa"

#: src/indicator/mod.rs:87
msgid "Finishing"
msgstr "Dokončuje sa"

#: src/indicator/mod.rs:91
#, c-format
msgid "Error: %s"
msgstr "Chyba: %s"

#: src/indicator/notify.rs:60
msgid "🎤 Dictation: listening"
msgstr "🎤 Diktovanie: počúva sa"

#: src/indicator/notify.rs:61
msgid "Speak now — tap your shortcut again to stop."
msgstr "Môžete hovoriť — opätovným stlačením klávesovej skratky zastavíte."

#: src/indicator/notify.rs:64
msgid "💬 Dictation: transcribing"
msgstr "💬 Diktovanie: prepisuje sa"

#: src/indicator/notify.rs:65
msgid "Converting speech to text…"
msgstr "Prebieha prevod reči na text…"

#: src/indicator/notify.rs:68
msgid "⏳ Dictation: finishing"
msgstr "⏳ Diktovanie: dokončuje sa"

#: src/indicator/notify.rs:69
msgid "Inserting the final text…"
msgstr "Vkladá sa výsledný text…"

#: src/indicator/notify.rs:72
msgid "⚠️ Dictation error"
msgstr "⚠️ Chyba diktovania"

#: src/controller.rs:209 src/controller.rs:832 src/inject/mod.rs:61
msgid "Focus lost"
msgstr "Zameranie textového poľa sa stratilo"

#: src/controller.rs:211
msgid "No speech detected"
msgstr "Nebola rozpoznaná žiadna reč"

#: src/controller.rs:213
msgid "Background noise is high"
msgstr "Úroveň okolitého hluku je príliš vysoká"

#: src/controller.rs:763
msgid "Dictation target closed"
msgstr "Cieľ diktovania sa zatvoril"

#: src/controller.rs:828
msgid "Refusing to type into a password field"
msgstr "Do poľa pre heslo nie je možné písať"

#: src/controller.rs:829
msgid "No text field is focused"
msgstr "Nie je zamerané žiadne textové pole"

#: src/shortcut/retry.rs:282
#, c-format
msgid "dictation hotkey unavailable: %s"
msgstr "Klávesová skratka na diktovanie je nedostupná: %s"

#: src/inject/mod.rs:55
msgid "focused field is secure (password); refusing to inject"
msgstr "Zamerané pole je zabezpečené (heslo); text sa nevloží"

#: src/inject/mod.rs:59
msgid "no editable target is focused"
msgstr "Nie je zamerané žiadne upraviteľné pole"

#: src/inject/mod.rs:65
#, c-format
msgid "injection backend unavailable: %s"
msgstr "Systém na vkladanie textu nie je dostupný: %s"

#: src/inject/mod.rs:70
#, c-format
msgid "injection backend error: %s"
msgstr "Chyba systému na vkladanie textu: %s"
