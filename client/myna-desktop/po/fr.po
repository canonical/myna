msgstr "le champ focalisé est protégé (mot de passe) ; refus d'écrire"

#: src/inject/mod.rs:83
msgid "no editable target is focused"
msgstr "aucun champ de texte éditable n'est focalisé"

#: src/inject/mod.rs:88
#, c-format
msgid "injection backend unavailable: %s"
msgstr "backend d'insertion indisponible : %s"

