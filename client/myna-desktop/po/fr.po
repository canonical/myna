msgstr "raccourci de dictée indisponible: %s"

#: src/backend.rs:47
msgid ""
"no backend is connected - install one and connect it, e.g. `sudo snap "
"connect myna:backend myna-whisper`"
msgstr ""
"aucun backend n'est connecté - installez-en un et connectez-le, ex. `sudo "
"snap connect myna:backend myna-whisper`"

#: src/backend.rs:54
#, c-format
msgid ""
"%s backends are connected; disconnect all but one (`snap connections myna`)"
msgstr ""
"%s backends sont connectés ; déconnectez-en tous sauf un (`snap "
"connections myna`)"

#: src/inject/mod.rs:80
