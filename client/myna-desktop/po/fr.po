msgid "Converting speech to text…"
msgstr "Conversion de la voix en texte…"

#: src/indicator/notify.rs:68
msgid "⏳ Dictation: finishing"
msgstr "⏳ Dictée : finalisation"

#: src/indicator/notify.rs:69
msgid "Inserting the final text…"
msgstr "Insertion du texte final…"

#: src/indicator/notify.rs:72
msgid "⚠️ Dictation error"
msgstr "⚠️ Erreur de dictée"

#: src/controller.rs:196
msgid "Focus lost"
msgstr "Focus perdu"

#: src/controller.rs:198
msgid "No speech detected"
msgstr "Aucune voix détectée"

#: src/controller.rs:522
msgid "Dictation target closed"
msgstr "Cible de dictée fermée"

#: src/controller.rs:583
msgid "Refusing to type into a password field"
msgstr "Refus d'écrire dans un champ de mot de passe"

#: src/controller.rs:584
msgid "No text field is focused"
msgstr "Aucun champ de texte n'est focalisé"

