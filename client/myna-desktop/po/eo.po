msgid "no editable target is focused"
msgstr "neniu modifebla celo estas en fokuso"

#: src/inject/mod.rs:65
#, c-format
msgid "injection backend unavailable: %s"
msgstr "interna modulo por enmeto ne atingebla: %s"

