msgstr "⏳ Diktado: kompletigante"

#: src/indicator/notify.rs:69
msgid "Inserting the final text…"
msgstr "Enmetante la kompletan tekston…"

#: src/indicator/notify.rs:72
msgid "⚠️ Dictation error"
msgstr "⚠️ Eraro pri diktado"

