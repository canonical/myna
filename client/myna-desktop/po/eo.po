msgstr "Fokuso perdiĝis"

#: src/controller.rs:211
msgid "No speech detected"
msgstr "Ne trovis parolon"

#: src/controller.rs:213
msgid "Background noise is high"
msgstr "Fona bruo estas laŭta"

