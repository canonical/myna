msgstr "Ŝarĝante modelon…"

#: src/indicator/mod.rs:85
msgid "Listening"
msgstr "Aŭskultante"

#: src/indicator/mod.rs:86
msgid "Transcribing"
msgstr "Transskribante"

#: src/indicator/mod.rs:87
msgid "Finishing"
msgstr "Kompletigante"

#: src/indicator/mod.rs:91
#, c-format
msgid "Error: %s"
