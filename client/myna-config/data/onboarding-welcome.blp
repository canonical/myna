using Gtk 4.0;
using Adw 1;

template $OnboardingWelcome: Adw.Bin {
  child: Gtk.ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 540;
      valign: center;
      margin-start: 24;
      margin-end: 24;

      child: Gtk.Box {
        orientation: vertical;

        Gtk.Image {
          resource: "/com/canonical/Myna/Config/icons/scalable/apps/com.canonical.Myna.Config.svg";
          pixel-size: 96;
          margin-bottom: 12;
          accessible-role: presentation;
        }

        $BalancedLabel {
          label: _("Set up Dictation");
          margin-bottom: 8;

          styles [
            "onboarding-title",
          ]
        }

        $BalancedLabel {
          label: _("Dictation runs locally, with no data leaving your computer.");
        }
      };
    };
  };
}
