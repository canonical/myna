using Gtk 4.0;
using Adw 1;

template $OnboardingWindow: Adw.ApplicationWindow {
  default-width: 800;
  default-height: 600;
  title: _("Dictation");

  content: Adw.ToolbarView {
    // Toasts rise above the footer rather than over Next.
    content: Adw.ToastOverlay overlay {
      child: Adw.NavigationView navigation {};
    };

    [bottom]
    Gtk.Box actions {
      halign: end;
      margin-start: 24;
      margin-end: 24;
      margin-top: 12;
      margin-bottom: 24;

      Gtk.Button forward_button {
        label: _("Next");
        sensitive: false;
      }
    }
  };
}
