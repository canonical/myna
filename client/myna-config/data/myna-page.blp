using Gtk 4.0;
using Adw 1;

template $MynaPage: Adw.NavigationPage {
  title: _("Myna");

  child: Adw.PreferencesPage preferences_page {
    title: _("Myna");
    icon-name: "audio-input-microphone-symbolic";

    Adw.PreferencesGroup shortcut_group {
      title: _("Keyboard shortcut");

      Adw.ActionRow shortcut_row {
        title: _("Press to start and stop");

        [suffix]
        Gtk.Stack shortcut_stack {
          hhomogeneous: false;
          valign: center;

          Gtk.StackPage {
            name: "idle";

            child: Gtk.Box {
              Gtk.Box shortcut_keys {
                spacing: 4;
                margin-end: 6;
                valign: center;
              }

              Gtk.Button shortcut_button {
                label: _("Set up");
                sensitive: false;
                valign: center;
              }
            };
          }

          Gtk.StackPage {
            name: "capture";

            child: Gtk.Box {
              spacing: 12;

              Gtk.Label capture_field {
                label: _("Press a shortcut…");
                valign: center;

                styles [
                  "shortcut-capture",
                ]
              }

              Gtk.Button capture_cancel {
                label: _("Cancel");
                valign: center;
              }
            };
          }
        }
      }
    }

    Adw.PreferencesGroup settings_group {
      title: _("Dictation");
    }

    Adw.PreferencesGroup model_group {
      title: _("Model");
      visible: false;

      Gtk.Button install_button {
        visible: false;
        margin-top: 12;

        accessibility {
          label: _("Install more models");
        }

        child: Gtk.Box {
          orientation: vertical;
          halign: center;
          spacing: 2;
          margin-top: 8;
          margin-bottom: 8;

          Gtk.Box {
            halign: center;
            spacing: 6;

            Gtk.Label {
              label: _("Install more models");
            }

            Gtk.Image {
              icon-name: "go-next-symbolic";
            }
          }

          Gtk.Label install_hint {
            visible: false;
            justify: center;
            wrap: true;
            wrap-mode: word_char;

            styles [
              "caption",
              "dim-label",
            ]
          }
        };

        styles [
          "card",
        ]
      }
    }
  };
}
