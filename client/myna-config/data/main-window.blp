using Gtk 4.0;
using Adw 1;

template $MainWindow: Adw.ApplicationWindow {
  default-width: 900;
  default-height: 640;
  title: _("Myna Settings");

  content: Adw.ToastOverlay overlay {
    child: Adw.NavigationSplitView split_view {
      show-content: true;

      sidebar: Adw.NavigationPage {
        title: _("Settings");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Gtk.ListBox sidebar_list {
            styles [
              "navigation-sidebar",
            ]

            selection-mode: single;

            Adw.ActionRow myna_row {
              activatable: true;
              title: _("Myna");
              subtitle: _("Dictation preferences");

              [prefix]
              Gtk.Image {
                icon-name: "audio-input-microphone-symbolic";
                accessible-role: presentation;
              }
            }

            Adw.ActionRow diagnostics_row {
              activatable: true;
              title: _("About and Diagnostics");
              subtitle: _("Backend status and error details");

              [prefix]
              Gtk.Image {
                icon-name: "dialog-information-symbolic";
                accessible-role: presentation;
              }
            }
          };
        };
      };
    };
  };
}
