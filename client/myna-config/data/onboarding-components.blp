using Gtk 4.0;
using Adw 1;

template $OnboardingComponents: Adw.Bin {
  child: Gtk.ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 540;
      valign: center;
      margin-start: 24;
      margin-end: 24;

      child: Gtk.Box {
        orientation: vertical;

        $BalancedLabel {
          label: _("Install components");
          margin-bottom: 8;

          styles [
            "onboarding-title",
          ]
        }

        $BalancedLabel description {
          label: _("Dictation requires some additional components, including the optimal speech-to-text model for your computer. Installation might take a few minutes.");
          margin-bottom: 32;
        }

        // One width for every label, so the button does not jump between
        // its states.
        Gtk.Button install_button {
          halign: center;

          child: Gtk.Stack install_labels {
            hhomogeneous: true;
            vhomogeneous: true;

            Gtk.StackPage {
              name: "offer";

              child: Gtk.Label {
                label: _("Install all components");
              };
            }

            Gtk.StackPage {
              name: "installing";

              child: Gtk.Label {
                label: _("Installing…");
              };
            }

            Gtk.StackPage {
              name: "installed";

              child: Gtk.Label {
                label: _("Installed");
              };
            }
          };
        }

        // The download size, what is installing, or how setting up goes.
        Gtk.Box status {
          halign: center;
          spacing: 8;
          margin-top: 12;

          Gtk.Spinner status_spinner {
            visible: false;
          }

          Gtk.Image status_warning {
            icon-name: "dialog-warning-symbolic";
            visible: false;

            styles [
              "warning",
            ]
          }

          // Tabular digits, so the centred row does not shift the spinner
          // at every percent.
          Gtk.Label status_label {
            wrap: true;
            natural-wrap-mode: word;
            justify: center;

            styles [
              "numeric",
            ]
          }
        }
      };
    };
  };
}
