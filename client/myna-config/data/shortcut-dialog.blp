using Gtk 4.0;
using Adw 1;

template $ShortcutDialog: Adw.Dialog {
  title: _("Set Shortcut");
  // A fixed content size makes libadwaita 1.5 mismeasure the dialog, and
  // warn, once the wrapped refusal appears.
  follows-content-size: true;
  // libadwaita 1.5 focuses nothing in a dialog without a focusable child,
  // and key events only reach the focused widget's ancestors.
  focus-widget: capture;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.Box capture {
      focusable: true;
      orientation: vertical;
      spacing: 12;
      margin-start: 24;
      margin-end: 24;
      margin-top: 12;
      margin-bottom: 24;

      Gtk.Label {
        label: _("Press the keys for dictation, for example:");
        justify: center;
        wrap: true;
        max-width-chars: 40;
      }

      Gtk.Box example {
        halign: center;
        spacing: 8;
        margin-bottom: 12;

        styles [
          "dim-label",
        ]
      }

      Gtk.Label refusal {
        visible: false;
        justify: center;
        wrap: true;
        max-width-chars: 40;

        styles [
          "error",
        ]
      }

      Gtk.Label {
        label: _("Use Ctrl, Alt or Super with another key, or a function key. Press Escape to cancel.");
        justify: center;
        wrap: true;
        max-width-chars: 40;

        styles [
          "dim-label",
        ]
      }
    };
  };
}
