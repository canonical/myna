msgid_plural "{count} languages"
msgstr[0] "{count} 种语言"

#. TRANSLATORS: {language} is the user's language named in that language, such as
#. "Deutsch" or "中文", inserted as-is in the nominative. If your grammar would
#. inflect it, rephrase, e.g. "Najlepszy dla języka: {language}".
#: src/model_family.rs:280
#, python-brace-format
msgid "Best for {language}"
msgstr "最适合 {language}"

#. TRANSLATORS: Shown under "Install more models" when a model not installed would
#. transcribe the user's language better. {language} is that language named in
#. itself, such as "Deutsch" or "中文", inserted as-is in the nominative. If your
#. grammar would inflect it, rephrase, e.g. "Dostępny jest lepszy model dla
#. języka: {language}".
#: src/model_family.rs:293
#, python-brace-format
msgid "A better model for {language} is available"
msgstr "有更适合 {language} 的模型"

#: src/model_family.rs:296
msgid "A recommended model is available"
msgstr "有可用的推荐模型"

#. TRANSLATORS: Shown under "Install more models" while a model installs. {model}
