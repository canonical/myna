msgstr "{languages} +{count}"

#: src/model_family.rs:243
msgid "{count} language"
msgid_plural "{count} languages"
msgstr[0] "{count} språk"
msgstr[1] "{count} språk"

#. TRANSLATORS: {language} is the user's language named in that language, such as "Deutsch" or "中文", inserted as-is in the nominative. If your grammar would inflect it, rephrase, e.g. "Najlepszy dla języka: {language}".
#: src/model_family.rs:280
msgid "Best for {language}"
msgstr "Bäst för {language}"

#. TRANSLATORS: Shown under "Install more models" when a model not installed would transcribe the user's language better. {language} is that language named in itself, such as "Deutsch" or "中文", inserted as-is in the nominative. If your grammar would inflect it, rephrase, e.g. "Dostępny jest lepszy model dla języka: {language}".
#: src/model_family.rs:293
msgid "A better model for {language} is available"
msgstr "En bättre modell för {language} finns tillgänglig"

#: src/model_family.rs:296
msgid "A recommended model is available"
msgstr "En rekommenderad modell finns tillgänglig"

#. TRANSLATORS: Shown under "Install more models" while a model installs. {model} is a model family, such as "Whisper", and {percent} how much of its download has arrived, a number from 0 to 100.
#: src/model_family.rs:306
msgid "Installing {model} {percent}%"
msgstr "Installerar {model} {percent}%"

#. TRANSLATORS: Shown under "Install more models" while a model installs. {model} is a model family, such as "Whisper".
#: src/model_family.rs:309
msgid "Installing {model}…"
msgstr "Installerar {model}…"

#: src/presentation.rs:47
msgid "value is invalid"
msgstr "värdet är ogiltigt"

#: src/presentation.rs:48
msgid "value must be true or false"
msgstr "värdet måste vara sant eller falskt"

#: src/presentation.rs:49
msgid "value must be a number"
msgstr "värdet måste vara ett tal"

#: src/presentation.rs:50
msgid "value must be text"
msgstr "värdet måste vara text"

#: src/presentation.rs:51
msgid "value must be a positive number"
msgstr "värdet måste vara ett positivt tal"

#: src/presentation.rs:52
msgid "value must be zero or a positive number"
msgstr "värdet måste vara noll eller ett positivt tal"

#: src/presentation.rs:53
msgid "value must be a non-negative whole number"
msgstr "värdet måste vara ett icke-negativt heltal"

#. TRANSLATORS: {choices} lists the allowed values, such as "cpu, cuda".
#: src/presentation.rs:56
msgid "value must be one of {choices}"
msgstr "värdet måste vara ett av följande: {choices}"

#: src/presentation.rs:59
msgid "this value cannot be edited"
msgstr "det här värdet kan inte redigeras"

#: src/presentation.rs:158
msgid "Which version of this model to run."
msgstr "Anger vilken version av den här modellen som ska köras."

#: src/presentation.rs:165
msgid "The inference engine this model runs on."
msgstr "Den inferensmotor som modellen körs på."

#: src/presentation.rs:171
msgid "Streaming output"
msgstr "Strömmande utdata"

#: src/presentation.rs:172
msgid "Emit partial transcription results while speech is being processed."
msgstr "Skicka partiella transkriptionsresultat medan talet bearbetas."

#: src/presentation.rs:179
msgid ""
"Unload the inference service after this many idle seconds; zero disables the "
"delay."
msgstr ""
"Ladda ur inferenstjänsten efter så här många sekunders inaktivitet; noll "
"inaktiverar fördröjningen."

#: src/presentation.rs:185
msgid "Verbose logging"
msgstr "Utförlig loggning"

#: src/presentation.rs:186
msgid "Write additional diagnostics to the system log."
msgstr "Skriv ytterligare diagnostik i systemloggen."

#: src/presentation.rs:192
msgid "Socket path"
msgstr "Socket-sökväg"

#: src/presentation.rs:193
msgid "Raw Unix socket path used by the transcription service."
msgstr "Unix-socket-sökväg som används direkt av transkriptionstjänsten."

#: src/presentation.rs:199
msgid "Minimum speech before pause commit (seconds)"
msgstr "Minsta talmängd före bekräftelse vid paus (sekunder)"

#: src/presentation.rs:200
msgid "Speech required before a pause can commit a transcript chunk."
msgstr "Tal som krävs innan en paus kan bekräfta ett transkriptionsblock."

#: src/presentation.rs:205
msgid "Pause length for commit (seconds)"
msgstr "Pauslängd för bekräftelse (sekunder)"

#: src/presentation.rs:206
msgid "Silence duration that commits the current transcript chunk."
msgstr "Tystnadsperiod som bekräftar det aktuella transkriptionsblocket."

#: src/presentation.rs:211
msgid "Maximum uncommitted audio (seconds)"
msgstr "Längsta obekräftade ljud (sekunder)"

#: src/presentation.rs:212
msgid ""
"Maximum speech window retained before a transcript chunk is forced to commit."
msgstr ""
"Längsta talfönster som behålls innan ett transkriptionsblock tvingas "
"bekräftas."

#: src/presentation.rs:217
msgid "Partial result interval (seconds)"
msgstr "Intervall för partiella resultat (sekunder)"

#: src/presentation.rs:218
msgid ""
"Interval between unstable partial results; zero disables partial results."
msgstr ""
"Intervall mellan instabila partiella resultat; noll inaktiverar partiella "
"resultat."

#: src/presentation.rs:223
msgid "Partial result audio window (seconds)"
msgstr "Ljudfönster för partiella resultat (sekunder)"

#: src/presentation.rs:224
msgid ""
"Recent uncommitted audio used for partial results; zero uses the whole "
"window."
msgstr ""
"Senaste obekräftade ljudet som används för partiella resultat; noll använder "
"hela fönstret."

#: src/presentation.rs:229
msgid "Compute type"
msgstr "Beräkningstyp"

#: src/presentation.rs:230
msgid ""
"Runtime numeric format override. Leave the model's own value unchanged "
"unless required."
msgstr ""
"Åsidosättning av numeriskt format vid körning. Lämna modellens eget värde "
"oförändrat om det inte krävs."

#: src/presentation.rs:236
msgid "Attention context size"
msgstr "Storlek på uppmärksamhetskontext"

#: src/presentation.rs:237
msgid ""
"Model-specific latency and accuracy context. Empty uses the engine default."
msgstr ""
"Modellspecifik kontext för fördröjning och noggrannhet. Tomt använder "
"motorns standardvärde."

#: src/presentation.rs:296
msgid "This model provides no description for this setting."
msgstr "Den här modellen saknar beskrivning för den här inställningen."

#. TRANSLATORS: {percent} is how much of the download has arrived, a number from 0 to 100.
#: src/ui/install_control.rs:131
msgid "Installing {percent}%"
msgstr "Installerar {percent}%"

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:41
msgid "Sounds on start, stop and error"
msgstr "Ljud vid start, stopp och fel"

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:42
msgid ""
"Play a short sound when dictation starts listening, when it stops, and when "
"it fails."
msgstr ""
"Spela ett kort ljud när dikteringen börjar lyssna, när den slutar och när "
"den misslyckas."

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:50
msgid "Sound style"
msgstr "Ljudstil"

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:51
msgid ""
"Which sounds play: Chime is a struck bar, Bird whistled chirps, Voice the "
"hums people make while listening, Marimba a rising fifth, Water falling "
"drops, Radio a walkie-talkie and Strings a plucked koto."
msgstr ""
"Vilka ljud som spelas: Klang är en anslagen klangstav, Fågel är visslande "
"kvitter, Röst är människors nynnande när de lyssnar, Marimba är en stigande "
"kvint, Vatten är fallande droppar, Radio är en kommunikationsradio och "
"Stränginstrument är en knäppt koto."

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:60
msgid "When to transcribe"
msgstr "När transkribering ska ske"

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:61
msgid ""
"As you speak shows partial text in the field while you talk; When you stop "
"injects the whole transcript once the utterance ends."
msgstr ""
"”Medan du talar” visar partiell text i fältet medan du talar; ”När du slutar"
"” infogar hela transkriptionen när yttrandet avslutas."

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:69
msgid "Spoken language"
msgstr "Talat språk"

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:70
msgid ""
"A BCP-47-ish code (en, fr, zh) for the language you dictate in. The model "
"skips language detection and decodes in this language; a code that does not "
"match what is spoken degrades the transcript. Empty lets the model decide."
msgstr ""
"En ungefärlig BCP 47-kod (en, fr, zh) för språket du dikterar på. Modellen "
"hoppar över språkidentifiering och avkodar på detta språk; en kod som inte "
"motsvarar det talade språket försämrar transkriptionen. Tomt låter modellen "
"avgöra."

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:80
msgid "Indicator style"
msgstr "Indikatorstil"

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:81
msgid ""
"All three render the same calibrated audio envelope: Default is a level bar "
"in the accent colour, Ribbon a flowing GPU wave, VU meter a segmented meter."
msgstr ""
"Alla tre återger samma kalibrerade ljudkurva: Standard är en nivåstapel i "
"accentfärg, Band en flytande GPU-våg och VU-mätare en segmenterad mätare."

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:91
msgid "Stop after silence (seconds)"
msgstr "Stoppa efter tystnad (sekunder)"

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:92
msgid ""
"With tap-to-start activation, end the dictation session on its own after "
"this many seconds without speech. 0 keeps it running until the next tap. "
"Hold-to-talk always ends with the key."
msgstr ""
"Med aktivering genom tryck avslutas dikteringssessionen automatiskt efter så "
"här många sekunder utan tal. 0 gör att den fortsätter till nästa tryckning. "
"Håll för att tala avslutas alltid när tangenten släpps."

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:101
msgid "Vocabulary"
msgstr "Ordförråd"

#: ../data/glib-2.0/schemas/com.canonical.Myna.Dictation.gschema.xml:102
msgid ""
"Names and terms the model should prefer when it is unsure, such as "
"\"Siobhan\" or \"PipeWire\". Up to 100 words or short phrases."
msgstr ""
"Namn och termer som modellen bör föredra när den är osäker, till exempel "
"\"Siobhan\" eller \"PipeWire\". Högst 100 ord eller korta fraser."

#: data/com.canonical.Myna.Config.metainfo.xml:9
msgid "Set up and configure local dictation"
msgstr "Konfigurera lokal diktering"

#: data/com.canonical.Myna.Config.metainfo.xml:14
msgid ""
"Myna turns speech into text on your computer, with no audio or text leaving "
"it. Myna Settings guides you through installing it and a speech model, then "
"configures dictation and its speech models."
msgstr ""
"Myna omvandlar tal till text på datorn utan att ljud eller text lämnar den. "
"Myna-inställningar vägleder dig genom installationen av Myna och en "
"talmodell och konfigurerar sedan dikteringen och dess talmodeller."

#: data/com.canonical.Myna.Config.desktop:4
msgid "Dictation Settings"
msgstr "Dikteringsinställningar"

#: data/com.canonical.Myna.Config.desktop:5
msgid "Configure Myna dictation and its speech models"
msgstr "Konfigurera Myna-diktering och dess talmodeller"

#. TRANSLATORS: Search terms for this application. Keep every semicolon, including the last.
#: data/com.canonical.Myna.Config.desktop:12
msgid "dictation;speech;transcription;voice;model;"
msgstr "diktering;tal;transkribering;röst;modell;"
