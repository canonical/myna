#: src/backend/mod.rs:75
#, c-format
msgid "cannot reach backend: %s"
msgstr "nedá sa dosiahnuť backend: %s"

#: src/backend/mod.rs:78
#, c-format
msgid "handshake failed: %s"
msgstr "handshake zlyhal: %s"

#: src/backend/mod.rs:83
#, c-format
msgid "session rejected: %1$s: %2$s"
msgstr "relácia odmietnutá: %1$s: %2$s"

#: src/backend/mod.rs:90
#, c-format
msgid "malformed event from backend: %s"
msgstr "chybná udalosť z backendu: %s"

#: src/backend/mod.rs:92
msgid "backend connection closed unexpectedly"
msgstr "spojenie s backendom neočakávane ukončené"

#: src/backend/mod.rs:94
#, c-format
msgid "transport error: %s"
msgstr "chyba prenosu: %s"

#: src/backend/share.rs:73
msgid ""
"no backend is connected - install one and connect it, e.g. `sudo snap "
"connect myna:backend myna-whisper`"
msgstr ""
"nie je pripojený žiadny backend – nainštalujte a pripojte ho, napr. `sudo "
"snap connect myna:backend myna-whisper`"

#: src/backend/share.rs:80
#, c-format
msgid "%s is connected but offers no Unix socket"
msgstr "%s je pripojený, ale neposkytuje Unix socket"

#: src/backend/share.rs:85
#, c-format
msgid "%s is connected but its server is not running"
msgstr "%s je pripojený, ale jeho server nebeží"

#: src/backend/share.rs:91
#, c-format
msgid "connected shares with an unreadable provider.env: %s"
msgstr "pripojené zdieľania s nečitateľným provider.env: %s"

#: src/backend/share.rs:101
#, c-format
msgid ""
"%1$s backends are connected (%2$s); disconnect all but one (`snap "
"connections myna`)"
msgstr ""
"je pripojených %1$s backendov (%2$s); odpojte všetky okrem jedného (`snap "
"connections myna`)"
