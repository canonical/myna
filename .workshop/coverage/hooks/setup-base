#!/bin/bash
# setup-base - runs as root at SDK install. Installs the quality-gate tools
# into /usr/local/bin, each a prebuilt release pinned by version and sha256,
# so every tool the gates run is stated here and verified on download.
#
# ShellCheck comes from here rather than apt: diagnostics move between
# releases (0.11 reports a trap-only function as SC2329 where 0.9 reports its
# body as SC2317), so the gate must not depend on the distro's version.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get install --yes --no-install-recommends ca-certificates curl xz-utils

GH=https://github.com
# url sha256 path-of-the-binary-in-the-archive
while read -r url sha256 member; do
  curl -fsSLo /tmp/tool "$url"
  echo "$sha256 /tmp/tool" | sha256sum -c -
  tar -xaf /tmp/tool -C /usr/local/bin --strip-components="$(tr -cd / <<<"$member" | wc -c)" "$member"
  rm /tmp/tool
done <<TOOLS
$GH/taiki-e/cargo-llvm-cov/releases/download/v0.6.21/cargo-llvm-cov-x86_64-unknown-linux-gnu.tar.gz 57f491aedf7cdb261538ceb49cbb1ee9d27df7ca205a5e1a009caaf5cb911afb cargo-llvm-cov
$GH/EmbarkStudios/cargo-deny/releases/download/0.20.2/cargo-deny-0.20.2-x86_64-unknown-linux-musl.tar.gz 9f12ed4c49936e09b48bf862b595cde2fe64fcbd9d74dfacac6131ca824c8d5f cargo-deny-0.20.2-x86_64-unknown-linux-musl/cargo-deny
$GH/bnjbvr/cargo-machete/releases/download/v0.9.1/cargo-machete-v0.9.1-x86_64-unknown-linux-musl.tar.gz 640b0814480b401e4e72201e52a13e1311b8eb8d7c27faa08bbe9886f252f26d cargo-machete-v0.9.1-x86_64-unknown-linux-musl/cargo-machete
$GH/rustsec/rustsec/releases/download/cargo-audit/v0.22.1/cargo-audit-x86_64-unknown-linux-gnu-v0.22.1.tgz 1890badd5f15831a9af4b074399fcd21e6f7c0fe42c84e9254cdffc9f813765c cargo-audit-x86_64-unknown-linux-gnu-v0.22.1/cargo-audit
$GH/sourcefrog/cargo-mutants/releases/download/v27.1.0/cargo-mutants-x86_64-unknown-linux-gnu.tar.gz dfe6dc37d0342c891d2829b5a695aa57c2d0edecef7e7d0399a30cc6e206411e cargo-mutants
$GH/koalaman/shellcheck/releases/download/v0.9.0/shellcheck-v0.9.0.linux.x86_64.tar.xz 700324c6dd0ebea0117591c6cc9d7350d9c7c5c287acbad7630fa17b1d4d9e2f shellcheck-v0.9.0/shellcheck
$GH/rhysd/actionlint/releases/download/v1.7.7/actionlint_1.7.7_linux_amd64.tar.gz 023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757 actionlint
TOOLS
