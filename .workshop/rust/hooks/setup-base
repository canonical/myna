#!/bin/bash
# setup-base - runs as root at SDK install. RUST must equal the channel in
# client/rust-toolchain.toml (`make lint-client` checks), so the toolchain
# cargo selects is the one in this layer rather than a per-workshop download.
set -euo pipefail
RUSTUP=1.29.1
RUSTUP_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
RUST=1.99.0

export DEBIAN_FRONTEND=noninteractive
apt-get install --yes --no-install-recommends build-essential ca-certificates curl

curl -fsSLo /tmp/rustup-init \
  "https://static.rust-lang.org/rustup/archive/$RUSTUP/x86_64-unknown-linux-gnu/rustup-init"
echo "$RUSTUP_SHA256 /tmp/rustup-init" | sha256sum -c -
chmod +x /tmp/rustup-init
sudo -iu workshop /tmp/rustup-init -y --no-modify-path --profile minimal \
  --default-toolchain "$RUST" --component clippy,rustfmt,rust-src,llvm-tools
rm /tmp/rustup-init

# shellcheck disable=SC2016  # $HOME and $PATH stay literal in the drop-in
echo 'PATH="$HOME/.cargo/bin:$PATH"' > /etc/profile.d/rust.sh
