#!/bin/bash -eu

socket_path="$(modelctl get ws.unix-socket)"
idle="$(modelctl get sleep-idle-seconds)"

# MODEL_DIR normally comes from model.yaml when modelctl runs the engine. This
# CPU-only snap bypasses modelctl run to avoid hardware scoring, so fall back
# to its single component directly.
MODEL_DIR="${MODEL_DIR:-$SNAP_COMPONENTS/model-fastconformer-480ms}"

# Idle-unload (T27) as in the other inference snaps.
#
# Emission mode (set at install, overridable with `modelctl set streaming=`).
# Defaults to true here: native partials + endpoint commits are this snap's
# reason to exist (008 US4). It is a key rather than a hardcoded flag only so
# the batch baseline is measurable on the same build.
streaming="$(modelctl get streaming 2>/dev/null || true)"
stream_args=()
[ "${streaming:-false}" = "true" ] && stream_args=(--streaming)

# Punctuation + truecasing (set at install, overridable with
# `modelctl set punctuation=`). PUNCT_DIR comes from model.yaml, the same way
# MODEL_DIR does, with the same direct fallback for the bypassed `modelctl run`.
# The transducer decodes lowercase and unpunctuated, so off means committing
# text the user has to fix by hand; it is a key so the raw output stays
# measurable on the same build.
PUNCT_DIR="${PUNCT_DIR:-$SNAP_COMPONENTS/model-punct-en}"
punctuation="$(modelctl get punctuation 2>/dev/null || true)"
punct_args=(--sherpa-punct-model "$PUNCT_DIR")
[ "${punctuation:-true}" = "false" ] && punct_args=(--sherpa-no-punct)

exec "$SNAP/bin/myna-server" \
    --socket "$socket_path" \
    --adapter sherpa \
    --model "$MODEL_DIR" \
    "${stream_args[@]}" \
    "${punct_args[@]}" \
    --sleep-idle-seconds "${idle:-0}" \
    --idle-action unload \
    "$@"
