#!/bin/sh
# The installed binary without a display: version, help, and the apply-plan
# and set-up executors that pkexec runs as root, which must refuse an empty
# plan, a plan naming anything but `snap` and a set-up installing anything
# but Myna's snaps before executing anything. Then the schema
# it shares with the daemon, compiled into the system schema source.
set -eu
upstream=$(dpkg-query -W -f '${Version}' myna-config | sed 's/-[^-]*$//')
myna-config --version | grep -qxF "myna-config $upstream"
myna-config --help >/dev/null
refused() {
    if out=$(myna-config "$1" "$2" 2>&1); then
        echo "plan was accepted: $1 $2" >&2
        exit 1
    fi
    echo "$out" | grep -q 'invalid apply plan'
}
for flag in --apply-plan --set-up; do
    refused $flag '[]'
    refused $flag '[{"executable":"sh","arguments":["-c","true"]}]'
done
refused --set-up '[{"executable":"snap","arguments":["install","--edge","firefox"]}]'
gsettings list-keys com.canonical.Myna.Dictation | grep -qx streaming-mode
# pkexec shows this action's message instead of the whole plan on its argv.
grep -qF '<annotate key="org.freedesktop.policykit.exec.path">/usr/bin/myna-config</annotate>' \
    /usr/share/polkit-1/actions/com.canonical.Myna.Config.policy
# The Xfce HUD host: the supervisor the autostart entry execs, started on Xfce only.
exe=$(sed -n 's/^Exec=//p' /etc/xdg/autostart/com.canonical.Myna.HudHost.desktop)
test -x "$exe"
grep -qxF 'OnlyShowIn=XFCE;' /etc/xdg/autostart/com.canonical.Myna.HudHost.desktop
