# Local reference checkouts (qwen3-snap, gemma4-snap, inference-snaps-cli).
# These carry their own .git and would commit as broken gitlinks — keep out.
reference/

# Generated corpora — regenerate with the dev/ builders:
#   server/fixtures/ -> dev/generate_fixtures.py  (synthetic espeak)
#   corpus/          -> dev/fetch_real_corpus.py  (real LibriSpeech)
#   .cache/          -> the ~337 MB LibriSpeech source download
fixtures/
corpus/
.cache/

# Snap build artifacts
whisper-snap/wheels/
whisper-snap/.hf-cache/
nemotron-snap/wheels/
nemotron-snap/.hf-cache/
qwen-snap/wheels/
qwen-snap/.hf-cache/
qwen-snap/build.log
*.snap
*.comp

# Python / uv
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
dist/

# Testbed output
results/

# Canonical Workshop per-project instance state (the .workshop/ definitions
# are committed; the lock ties a launched instance to this checkout).
.workshop.lock
