# Local reference checkouts (gemma4-snap, inference-snaps-cli).
# These carry their own .git and would commit as broken gitlinks — keep out.
reference/

fixtures/
corpus/
.cache/

# ...but myna-config's test fixtures are checked-in sources, not corpus data:
# `fixtures/` above is for audio clips, and it hid a directory the test suite
# cannot compile without.
!client/myna-config/tests/fixtures/

# Snap build artifacts
# .pip-cache/ is the persistent pip cache each snapcraft.yaml points
# PIP_CACHE_DIR at; it is meant to outlive the build VM, so it is not
# swept by `make clean-snaps`.
.pip-cache/
whisper-snap/wheels/
whisper-snap/.hf-cache/
*.snap
*.comp

# Python / uv
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
dist/

# Testbed output
results/

# Generated benchmark zipapp - rebuild with dev/build-bench.sh
myna-bench.pyz

# Canonical Workshop per-project instance state (the .workshop/ definitions
# are committed; the lock ties a launched instance to this checkout).
.workshop.lock

# Rust build artifacts
target/
debug/
release/
*.rs.bk
*.rlib
*.prof*
# Cargo.lock is deliberately tracked (client/): the workspace ships binaries,
# and myna-snap builds them with `cargo install --locked`, which silently
# resolves fresh versions when no lock is present. The two other lock files in
# the tree sit under directories already ignored wholesale (reference/,
# myna-snap/client/).
# snap build artifacts (weights staged by dev/download-models.sh, wheels by dev/prepare.sh)
parakeet-snap/components/model-*/
parakeet-snap/wheels/
parakeet-snap/wheelhouse-cuda/
parakeet-snap/*.snap
parakeet-snap/*.comp
# Coverage artifacts (feature 006)
client/target/coverage/
server/.coverage*
server/coverage-*.xml
server/htmlcov/
.coverage-work/
funasr-snap/components/model-*/
funasr-snap/wheels/
funasr-snap/*.snap
funasr-snap/*.comp
# FunASR model staged by dev/fetch_funasr_model.py (default --target)
funasr_model/
# mutation testing scratch (cargo-mutants, mutmut)
client/mutants.out/
client/mutants.out.old/
server/mutants/
# License text staged into each snap by dev/stage-licenses.sh
*-snap/licenses/
