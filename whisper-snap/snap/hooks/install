#!/bin/bash -eu

# shellcheck disable=SC2034  # used via process substitution below
tag="snap.$SNAP_INSTANCE_NAME.hook.install"

# Redirect stdout to stdout+syslog
exec 1> >(tee >(logger --tag="$tag"))
# Redirect stderr to stderr+syslog
exec 2> >(logger --stderr --priority error --tag="$tag")

#
# Set generic config
#

# The session socket, inside the provider content share, under the key
# modelctl's `status` reads for a ws+unix runtime server
# (runtimes/*/runtime.yaml) to report the entrypoint.
modelctl set --package ws.unix-socket="$SNAP_COMMON/share/provider/myna.sock"
modelctl set --package verbose="false"
# Idle-unload: release the model after this many idle seconds (0 = never).
# 5 min keeps frequent dictation warm but frees GPU/RAM when you walk away.
modelctl set --package sleep-idle-seconds="300"
# Emission mode. false = commit-on-finalize (one final at end of audio),
# true = progressive committed segments. A config key rather than a hardcoded
# flag so the same build can be measured both ways; the benchmark runner treats
# the presence of this key as the snap declaring it supports streaming at all.
modelctl set --package streaming="false"

#
# Select an engine.
#
# nvidia-gpu where modelctl can see an NVIDIA GPU, otherwise cpu. A sideload
# does not auto-connect hardware-observe, and `--auto` cannot score without it,
# so fall back to cpu by name: a snap with no active engine has a daemon that
# exits on every start, and connect-plug-hardware-observe re-selects later.
#
# The cpu engine's default model (base) needs the store, which a sideload or
# an offline machine cannot reach, and a failing hook fails the whole install.
# modelctl keeps the active model when the engine offers it, so seed the first
# installed one, default first. An accelerator-only sideload has no CPU model
# to seed: leave its engine unset until the administrator connects the required
# hardware interfaces and explicitly selects that engine.
#
installed_model() {
    # modelctl's engine/models commands score hardware or need an active
    # engine, neither of which works here, so read the manifests directly.
    "$SNAP/bin/python3" - "$1" <<'EOF'
import os, sys, yaml
snap, installed = os.environ["SNAP"], os.environ["SNAP_COMPONENTS"]
with open(f"{snap}/engines/{sys.argv[1]}/engine.yaml") as f:
    model = yaml.safe_load(f)["model"]
for name in [model["default"], *model["options"]]:
    with open(f"{snap}/models/{name}/model.yaml") as f:
        components = yaml.safe_load(f).get("components") or []
    if all(os.path.isdir(f"{installed}/{c}") for c in components):
        print(name)
        break
EOF
}

use_cpu() {
    local model
    model="$(installed_model cpu)"
    if [ -z "$model" ]; then
        echo "no CPU model component is installed: deferring engine selection"
        return 0
    fi
    snapctl set cache.active-model="$model"
    modelctl use-engine cpu --assume-yes --no-restart
}

# modelctl matches nvidia-gpu on the vendor id alone, so ask the driver first:
# one this snap cannot use (none, a module that did not build, older than
# CUDA 12) would get the GPU engine and its components for nothing (#49).
if ! snapctl is-connected hardware-observe && ! lscpu -V &>/dev/null; then
    echo "hardware-observe is not connected: selecting the cpu engine"
    use_cpu
elif ! python3 -m myna.server.cuda_probe 12.0; then
    echo "selecting the cpu engine"
    use_cpu
else
    modelctl use-engine --auto --assume-yes --no-restart --verbose || use_cpu
fi
