#!/bin/bash -eu

# shellcheck disable=SC2034  # used via process substitution below
tag="snap.$SNAP_INSTANCE_NAME.hook.install"

# Redirect stdout to stdout+syslog
exec 1> >(tee >(logger --tag="$tag"))
# Redirect stderr to stderr+syslog
exec 2> >(logger --stderr --priority error --tag="$tag")

#
# Set generic config
#

# The session socket, inside the provider content share, under the key
# modelctl's `status` reads for a ws+unix runtime server
# (runtimes/*/runtime.yaml) to report the entrypoint.
modelctl set --package ws.unix-socket="$SNAP_COMMON/share/provider/myna.sock"
modelctl set --package verbose="false"
# Idle-unload: release the model after this many idle seconds (0 = never).
modelctl set --package sleep-idle-seconds="300"
# Emission mode. false = commit-on-finalize (one final at end of audio),
# true = progressive committed segments. A config key rather than a hardcoded
# flag so the same build can be measured both ways; the benchmark runner treats
# the presence of this key as the snap declaring it supports streaming at all.
modelctl set --package streaming="true"
# SilenceCut chunked-commit defaults (seconds). Users can lower these with
# `sudo myna-parakeet.parakeet set stream-arm-seconds=5` etc.
modelctl set --package stream-arm-seconds="15"
modelctl set --package stream-silence-cut-seconds="0.5"
modelctl set --package stream-force-cut-seconds="60"
# Unstable partials between commits (display only). Cadence 0 = off;
# tail 0 = decode the whole uncommitted window.
modelctl set --package stream-partial-cadence-seconds="0.5"
modelctl set --package stream-partial-tail-seconds="0"

#
# Select an engine.
#
# nvidia-gpu where modelctl can see an NVIDIA GPU, otherwise cpu. A sideload
# does not auto-connect hardware-observe, and `--auto` cannot score without it,
# so fall back to cpu by name: it runs everywhere this snap installs, and a
# snap with no active engine has a daemon that exits on every start.
#
if snapctl is-connected hardware-observe || lscpu -V &>/dev/null; then
    modelctl use-engine --auto --assume-yes --no-restart --verbose ||
        modelctl use-engine cpu --assume-yes --no-restart
else
    echo "hardware-observe is not connected: selecting the cpu engine"
    modelctl use-engine cpu --assume-yes --no-restart
fi
