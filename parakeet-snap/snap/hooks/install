#!/bin/bash -eu

# shellcheck disable=SC2034  # used via process substitution below
tag="snap.$SNAP_INSTANCE_NAME.hook.install"

# Redirect stdout to stdout+syslog
exec 1> >(tee >(logger --tag="$tag"))
# Redirect stderr to stderr+syslog
exec 2> >(logger --stderr --priority error --tag="$tag")

#
# Set generic config
#

modelctl set --package socket.path="$SNAP_COMMON/run/ubustt.sock"
modelctl set --package verbose="false"
# Idle-unload: release the model after this many idle seconds (0 = never).
modelctl set --package sleep-idle-seconds="300"
# SilenceCut chunked-commit defaults (seconds). Users can lower these with
# `snap set parakeet stream-arm-seconds=5` etc.
modelctl set --package stream-arm-seconds="15"
modelctl set --package stream-silence-cut-seconds="0.5"
modelctl set --package stream-force-cut-seconds="60"

#
# CPU-only snap: no hardware auto-selection is needed. Only package config.
#
