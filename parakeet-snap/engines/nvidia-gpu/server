#!/bin/bash -eu

# The onnxruntime-cuda runtime component puts myna + onnxruntime-gpu on
# PYTHONPATH and the CUDA libraries on LD_LIBRARY_PATH
# (runtimes/onnxruntime-cuda/runtime.yaml). The base python3 runs it rather
# than the snap's venv, whose CPU onnxruntime would otherwise be imported.

socket_path="$(modelctl get ws.unix-socket)"
idle="$(modelctl get sleep-idle-seconds)"
stream_arm="$(modelctl get stream-arm-seconds)"
stream_silence_cut="$(modelctl get stream-silence-cut-seconds)"
stream_force_cut="$(modelctl get stream-force-cut-seconds)"
# `${x:-default}` treats an explicit 0 as unset, and 0 is how a user turns
# partials off, so test for the empty string instead.
stream_partial_cadence="$(modelctl get stream-partial-cadence-seconds 2>/dev/null || true)"
stream_partial_tail="$(modelctl get stream-partial-tail-seconds 2>/dev/null || true)"
[ -z "$stream_partial_cadence" ] && stream_partial_cadence=0.5
[ -z "$stream_partial_tail" ] && stream_partial_tail=0

streaming="$(modelctl get streaming 2>/dev/null || true)"
stream_args=()
[ "${streaming:-false}" = "true" ] && stream_args=(--streaming)

exec python3 -m myna.server \
    --socket "$socket_path" \
    --share-provider \
    --adapter parakeet \
    --device cuda \
    --model "${MODEL_DIR:?MODEL_DIR unset - is a model component installed? try: myna-parakeet.parakeet use-model parakeet-tdt-0.6b-v3-fp32}" \
    "${stream_args[@]}" \
    --stream-arm-s "${stream_arm:-15}" \
    --stream-silence-cut-s "${stream_silence_cut:-0.5}" \
    --stream-force-cut-s "${stream_force_cut:-60}" \
    --stream-partial-cadence-s "$stream_partial_cadence" \
    --stream-partial-tail-s "$stream_partial_tail" \
    --sleep-idle-seconds "${idle:-0}" \
    --idle-action unload \
    "$@"
